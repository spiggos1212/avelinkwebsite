# Clean URLs for Apache hosting (e.g. cPanel) — makes /about/ etc. (as
# referenced by the canonical/og:url tags and sitemap.xml) actually resolve,
# while the repo itself still keeps plain .html files for easy local testing.
# Not needed for local file:// browsing; only takes effect once deployed on
# an Apache server with mod_rewrite enabled. Verify/adjust once the real
# hosting environment is known — this assumes each *.html file lives at the
# repo root, same as now.

RewriteEngine On

# 1) /index.html -> / (avoid a duplicate, indexable "/index.html" URL)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 2) /page.html -> /page/ (canonicalize direct .html requests to the clean URL)
RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[\s?] [NC]
RewriteRule ^ /%1/ [R=301,L]

# 3) Serve /page/ (or /page) transparently from the matching page.html file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ $1.html [L]

DirectoryIndex index.html
